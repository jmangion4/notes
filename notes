/* =========================
   QUESTION 1 - utils.h
   ========================= */

/*
Question Title:
Reorganise the program into separate files using the best programming practices.

Question Description:
The functions must be separate from the main file. Use the name utils for your header file.
The implementation details of the functions must not be visible to any file that uses them.
The header file must be safe to include more than once.
*/

#ifndef UTILS_H
#define UTILS_H

int countVowels(char* s);
void reverseString(char* s);
int isPalindrome(char* s);
int countWords(char* s);

#endif
/* =========================
   QUESTION 1 - utils.c
   ========================= */

#include <stdio.h>
#include <string.h>
#include "utils.h"

// Counts how many vowels are inside the string
int countVowels(char* s) {
    int count = 0;

    for (int i = 0; i < strlen(s); i++) {
        char c = s[i];

        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
            c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U') {
            count++;
        }
    }

    return count;
}

// Reverses the string by swapping characters from both ends
void reverseString(char* s) {
    int len = strlen(s);

    for (int i = 0; i < len / 2; i++) {
        char temp = s[i];
        s[i] = s[len - 1 - i];
        s[len - 1 - i] = temp;
    }
}

// Checks if the string reads the same forwards and backwards
int isPalindrome(char* s) {
    int len = strlen(s);

    for (int i = 0; i < len / 2; i++) {
        if (s[i] != s[len - 1 - i]) {
            return 0;
        }
    }

    return 1;
}

// Counts the number of words in the string
int countWords(char* s) {
    int count = 0;
    int inWord = 0;

    for (int i = 0; i < strlen(s); i++) {
        if (s[i] != ' ' && inWord == 0) {
            inWord = 1;
            count++;
        }
        else if (s[i] == ' ') {
            inWord = 0;
        }
    }

    return count;
}
/* =========================
   QUESTION 1 - main.c
   ========================= */

#include <stdio.h>
#include "utils.h"

int main() {
    char words[5][20] = { "racecar", "hello", "level", "world", "madam" };
    int count = 5;

    for (int i = 0; i < count; i++) {
        printf("Word: %s\n", words[i]);
        printf("Vowels: %d\n", countVowels(words[i]));
        printf("Word count: %d\n", countWords(words[i]));
        printf("Is palindrome: %d\n", isPalindrome(words[i]));

        reverseString(words[i]);

        printf("Reversed: %s\n", words[i]);
        printf("\n");
    }

    return 0;
}
/* =========================
   GCC COMMAND FOR QUESTION 1
   =========================

gcc main.c utils.c -o question1.exe

