14. Connect to database

def connect_to_db(server, database):
    global connection
    try:
        connection = pyodbc.connect(f"""
            DRIVER={{ODBC Driver 17 for SQL Server}};
            SERVER={server};
            DATABASE={database};
            Trusted_Connection=yes;
        """)
    except Exception as e:
        raise(e)

15. Most experienced doctor

def get_most_experienced_doctor():
    try:
        cursor = connection.cursor()
        cursor.execute("""
            SELECT TOP 1 s.first_name,
                         s.last_name,
                         d.years_experience
            FROM doctors d
                 JOIN staff s
                 ON d.staff_id = s.staff_id
            ORDER BY d.years_experience DESC
        """)
        result = cursor.fetchone()
        print(result)
    except Exception as e:
        raise(e)
    finally:
        cursor.close()

16. Add staff role

def add_staff_role(conn):
    try:
        cursor = conn.cursor()
        rolename = input("Enter role name: ")
        basesalary = float(input("Enter base salary: "))
        requiredlicense = int(input("Enter license required (1/0): "))
        cursor.execute("""
            INSERT INTO staff_roles (role_name, base_salary, requires_license)
            VALUES (?, ?, ?)
        """, rolename, basesalary, requiredlicense)
        conn.commit()
        print("\nStaff role was added successfully.")
    except Exception as e:
        raise(e)
    finally:
        cursor.close()

